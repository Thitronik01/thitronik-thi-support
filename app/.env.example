# ============================================================================
# THITRONIK Thi Support — Umgebungsvariablen
# ----------------------------------------------------------------------------
# LOKAL:   Diese Datei nach `.env` kopieren und ausfüllen.
# NETLIFY: Die Werte unter Site configuration → Environment variables eintragen.
#          Die .env-Datei NICHT ins Repository committen.
# ============================================================================

# ─── 1) KI-Zugang (Anymize) — PFLICHT ───────────────────────────────────────
# Ohne diese beiden Werte läuft die Oberfläche, aber es kommt keine Antwort.
ANYMIZE_API_URL=
ANYMIZE_API_KEY=

# ─── 2) Modell — PFLICHT auf jeder Umgebung ─────────────────────────────────
# ⚠️ WICHTIG: Der Vorgänger-Bot war WOCHENLANG tot, weil das konfigurierte
# Modell vom Anbieter abgekündigt wurde (HTTP 404 bei jedem Aufruf) und der
# Modellname nur in einer nicht versionierten Variable stand.
# Nach jedem Deploy einmal prüfen:   /api/health?live=1
THI_MODEL=anthropic/claude-sonnet-4.6

# ─── 3) Zugangswort — dringend empfohlen ────────────────────────────────────
# Ohne diesen Wert ist die Seite öffentlich nutzbar — und damit auch der
# hinterlegte API-Schlüssel, auf eure Kosten. Ein gemeinsames Wort für alle
# Händler genügt; es wird im Browser gespeichert und bei jeder Anfrage geprüft.
# Leer lassen NUR, wenn die Seite anderweitig geschützt ist
# (z. B. Netlify Password Protection oder Identity).
THI_ZUGANGSWORT=

# ─── 4) Kostenbremsen (optional) ────────────────────────────────────────────
# Anfragen pro IP je 5 Minuten (Standard 20).
THI_RATE_LIMIT=20
# Globale Anfragen pro Tag (Standard 500) — die Notbremse gegen Kostenausreißer.
THI_DAILY_LIMIT=500
# Falsche Zugangswörter pro IP je 15 Minuten, danach Sperre (Standard 8).
# Schützt ein merkbares Zugangswort gegen Durchprobieren. Bewusst getrennt vom
# Tageslimit: Sonst könnte jemand mit Fehlversuchen das Kontingent leerlaufen
# lassen und echte Nutzer aussperren.
THI_FEHLVERSUCHE=8

# ⚠️ HINWEIS zu den Limits: Sie zählen PRO Function-Instanz. Netlify startet
# mehrere Instanzen parallel, daher sind sie nur eine grobe Bremse. Der
# eigentliche Schutz ist THI_ZUGANGSWORT. Für harte Limits braucht es einen
# geteilten Zähler (Netlify Blobs / Upstash) — siehe
# ../docs/02_ZIELARCHITEKTUR.md §2.2.

# ─── 5) Support-Korrekturen (optional) ──────────────────────────────────────
# Mitarbeiter können falsche Antworten korrigieren. Die Korrekturen werden als
# Commit ins Repository geschrieben (app/data/korrekturen.json) und wirken nach
# dem darauf folgenden Deploy — siehe ../docs/07_KORREKTUREN_ENTWUERFE.md.
#
# Feingranulares GitHub-Token (Fine-grained personal access token):
#   Repository access: NUR dieses Repository · Permissions: Contents → Read and write
# Ohne Token lässt sich die Oberfläche nutzen, aber keine Korrektur speichern
# (HTTP 503 mit Klartext-Meldung).
THI_GITHUB_TOKEN=
# Repository und Branch, in die geschrieben wird (Standard passt zum Deploy).
THI_GITHUB_REPO=Thitronik01/thitronik-thi-support
THI_GITHUB_BRANCH=main
# Pfad zur Wissensbasis IM REPOSITORY (Netlify-Base ist app/, im Repo liegt
# die Wissensbasis unter app/data).
THI_GITHUB_PFAD=app/data

# Optionales eigenes Wort für die FREIGABE von Korrekturen. Leer = das
# Zugangswort gilt auch für Freigaben (bei einem kleinen Team ausreichend;
# die Vier-Augen-Regel verhindert, dass jemand die eigene Korrektur freigibt).
# Fehlen beide Wörter, sind Freigaben deaktiviert (fail-closed).
THI_FREIGABEWORT=

# NUR LOKAL für dev-server.mjs: schreibt Korrekturen statt nach GitHub in
# data/korrekturen.json auf die Platte. Auf Netlify NICHT setzen.
# THI_KORREKTUREN_LOKAL=1
